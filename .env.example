DATABASE_URL=postgresql+psycopg://reamar:reamar_password@localhost:5433/reamar

# BuiltMind API (for fetch_builtmind: stahování dat z API). Nikdy necommitujte klíč.
# BUILTMIND_API_KEY=sk_live_...

# ----- Supabase (Auth) -----
# Project URL (Dashboard → Settings → Data API → Project URL)
# SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
#
# JWKS discovery URL (Dashboard → Settings → JWT Keys → URL).
# Public endpoint with signing keys — used by backend to verify
# Authorization: Bearer <access_token> from the frontend.
# SUPABASE_JWKS_URL=https://xxxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json
#
# (Optional, legacy) HS256 shared secret. Only needed if the project
# still issues HS256 tokens. New projects use asymmetric keys (JWKS above).
# SUPABASE_JWT_SECRET=
#
# Service-role key (Dashboard → Settings → API keys → Secret keys, or
# Legacy anon/service_role tab). SERVER-ONLY secret. Bypasses RLS.
# Required for admin broker CRUD (create/delete user in Supabase Auth).
# Never ship to frontend.
# SUPABASE_SERVICE_ROLE_KEY=

