#!/usr/bin/env bash
# Development server script - runs uvicorn with reload watching only src/

set -e

cd "$(dirname "$0")"

if [ ! -d ".venv" ]; then
    echo "Error: .venv not found. Run 'python3.11 -m venv .venv && source .venv/bin/activate && pip install -e .' first."
    exit 1
fi

source .venv/bin/activate

# Load .env if present (never committed — contains secrets)
if [ -f ".env" ]; then
  set -a; source .env; set +a
fi

exec uvicorn app.main:app --reload --app-dir src --port 8001 --reload-dir src --host 0.0.0.0
